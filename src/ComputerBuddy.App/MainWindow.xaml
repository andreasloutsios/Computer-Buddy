<Window x:Class="ComputerBuddy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComputerBuddy.App"
        mc:Ignorable="d"
        Title="Computer Buddy"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid>
        <Image x:Name="BuddyImage"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               SnapsToDevicePixels="True"
               UseLayoutRounding="True"
               RenderTransformOrigin="0.5,1.0"
               Cursor="Hand"
               ToolTip="Left-click: pet • Shift+Click: emote • Ctrl+Click: chat • Right-click: menu • Alt+Drag: move • Double-click: hide"
               MouseEnter="BuddyImage_MouseEnter"
               MouseLeave="BuddyImage_MouseLeave"
               MouseRightButtonUp="BuddyImage_MouseRightButtonUp"
               MouseLeftButtonDown="BuddyImage_MouseLeftButtonDown"
               MouseLeftButtonUp="BuddyImage_MouseLeftButtonUp"
               MouseMove="BuddyImage_MouseMove" />
        <Popup x:Name="ReminderPopup"
               IsOpen="False"
               Placement="Top"
               PlacementTarget="{Binding ElementName=BuddyImage}"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="#EE111111" CornerRadius="10" Padding="10" MaxWidth="220">
                <TextBlock x:Name="ReminderText" Foreground="White" TextWrapping="Wrap" />
            </Border>
        </Popup>
        <Popup x:Name="ActionPopup"
               IsOpen="False"
               Placement="Top"
               PlacementTarget="{Binding ElementName=BuddyImage}"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="#00000000" Padding="0" Margin="0,0,0,6">
                <TextBlock x:Name="ActionText" Text="!" FontSize="18" Foreground="#FFFFFFFF" FontWeight="SemiBold" />
            </Border>
        </Popup>
        <Popup x:Name="PetPopup"
               IsOpen="False"
               Placement="Top"
               PlacementTarget="{Binding ElementName=BuddyImage}"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="#00000000" Padding="0" Margin="0,0,0,6">
                <TextBlock x:Name="PetText" Text="♥" FontSize="22" Foreground="#FFEF476F" FontWeight="Bold" />
            </Border>
        </Popup>
    </Grid>
</Window>
