<Window x:Class="ComputerBuddy.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computer Buddy Settings"
        Width="520"
        Height="760"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Size (scale)" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,12">
                <Slider x:Name="ScaleSlider" Minimum="1" Maximum="10" Width="360" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="ScaleValue" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Speed (DIP/sec)" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,12">
                <Slider x:Name="SpeedSlider" Minimum="20" Maximum="400" Width="360" TickFrequency="10" IsSnapToTickEnabled="False" />
                <TextBlock x:Name="SpeedValue" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Character" FontWeight="SemiBold" />
            <StackPanel Orientation="Vertical" Margin="0,6,0,12">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Source" Width="110" VerticalAlignment="Center" />
                    <ComboBox x:Name="CharacterModeComboBox" Width="240" />
                </DockPanel>

                <TextBlock Text="Minifigure builder" FontWeight="SemiBold" Margin="0,6,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Head" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="HeadComboBox" />

                    <TextBlock Grid.Row="1" Text="Body" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="BodyComboBox" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="2" Text="Hat" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="HatComboBox" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="3" Text="Accessory" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="AccessoryComboBox" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="4" Text="Skin" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="SkinColorTextBox" Margin="0,10,0,0" />

                    <TextBlock Grid.Row="5" Text="Shirt" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="ShirtColorTextBox" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="6" Text="Pants" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="PantsColorTextBox" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="7" Text="Hat color" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="HatColorTextBox" Margin="0,6,0,0" />

                    <TextBlock Grid.Row="8" Text="Accent" VerticalAlignment="Center" Margin="0,6,0,0" />
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="AccentColorTextBox" Margin="0,6,0,0" />
                </Grid>

                <TextBlock Text="Sprite sheet (PNG) + manifest (JSON)" FontWeight="SemiBold" Margin="0,14,0,6" />
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="BrowsePngButton" Content="Browse PNG" Width="110" Click="BrowsePngButton_Click" />
                    <TextBox x:Name="PngPathTextBox" Margin="10,0,0,0" />
                </DockPanel>
                <DockPanel>
                    <Button x:Name="BrowseJsonButton" Content="Browse JSON" Width="110" Click="BrowseJsonButton_Click" />
                    <TextBox x:Name="JsonPathTextBox" Margin="10,0,0,0" />
                </DockPanel>
            </StackPanel>

            <TextBlock Text="Reminders" FontWeight="SemiBold" />
            <StackPanel Orientation="Vertical" Margin="0,6,0,12">
                <CheckBox x:Name="RemindersEnabledCheckBox" Content="Enable reminders" />
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="Minutes" Width="110" VerticalAlignment="Center" />
                    <TextBox x:Name="ReminderMinutesTextBox" Width="80" />
                    <TextBlock Text="(1 - 1440)" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
                </DockPanel>
            </StackPanel>

            <TextBlock Text="OpenAI" FontWeight="SemiBold" />
            <StackPanel Orientation="Vertical" Margin="0,6,0,12">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Model" Width="110" VerticalAlignment="Center" />
                    <TextBox x:Name="ModelTextBox" />
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="API Key" Width="110" VerticalAlignment="Center" />
                    <PasswordBox x:Name="ApiKeyBox" />
                </DockPanel>
                <TextBlock x:Name="StatusText" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" Width="90" Margin="0,0,10,0" Click="ApplyButton_Click" />
                <Button Content="Save" Width="90" Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

