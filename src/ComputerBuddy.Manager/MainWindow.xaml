<Window x:Class="ComputerBuddy.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComputerBuddy.Manager"
        xmlns:conv="clr-namespace:ComputerBuddy.Manager.Converters"
        mc:Ignorable="d"
        Title="Computer Buddy Control Center" Height="820" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7FA"
        FontFamily="Segoe UI"
        TextElement.FontSize="13">

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#1A000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF3F6FF" />
                                <Setter Property="BorderBrush" Value="#332F7CF6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFEAF0FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="#22000000" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFFFF" BorderBrush="#14000000" BorderThickness="1" CornerRadius="14" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Computer Buddy Control Center" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="#FF6B7280" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ConnectButton" Content="Connect" Width="120" Click="ConnectButton_Click" />
                    <Button x:Name="StartBuddyButton" Content="Start Buddy" Width="120" Margin="10,0,0,0" Click="StartBuddyButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#14000000" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,14,0,0">
            <TabControl>
                <TabItem Header="Keybinds">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <GroupBox Header="Global hotkey (Show/Hide Buddy)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Enabled" VerticalAlignment="Center" />
                                    <CheckBox Grid.Row="0" Grid.Column="1" x:Name="HotkeyEnabledCheckBox" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Modifiers" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                        <CheckBox x:Name="HotkeyCtrlCheckBox" Content="Ctrl" Margin="0,0,14,0" />
                                        <CheckBox x:Name="HotkeyAltCheckBox" Content="Alt" Margin="0,0,14,0" />
                                        <CheckBox x:Name="HotkeyShiftCheckBox" Content="Shift" Margin="0,0,14,0" />
                                        <CheckBox x:Name="HotkeyWinCheckBox" Content="Win" />
                                    </WrapPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Key" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="HotkeyKeyComboBox" Width="200" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Header="Buddy interactions (fixed)">
                                <StackPanel>
                                    <TextBlock Text="Alt + Drag: move buddy" Margin="0,0,0,6" />
                                    <TextBlock Text="Double-click buddy: show/hide" Margin="0,0,0,6" />
                                    <TextBlock Text="Right-click buddy: menu" Margin="0,0,0,6" />
                                    <TextBlock Text="Left-click buddy: pet" Margin="0,0,0,6" />
                                    <TextBlock Text="Shift + Click: cycle emotes" Margin="0,0,0,6" />
                                    <TextBlock Text="Ctrl + Click: open chat" />
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Customize">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <GroupBox Header="Basics">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Character source" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CharacterModeComboBox" Width="280" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Scale" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Slider x:Name="ScaleSlider" Minimum="1" Maximum="10" Width="360" TickFrequency="1" IsSnapToTickEnabled="True" />
                                        <TextBlock x:Name="ScaleValue" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF6B7280" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Speed (DIP/sec)" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Slider x:Name="SpeedSlider" Minimum="20" Maximum="400" Width="360" TickFrequency="10" />
                                        <TextBlock x:Name="SpeedValue" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF6B7280" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Header="Minifigure (parts + palette)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Head" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="HeadComboBox" Width="280" HorizontalAlignment="Left" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Body" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="BodyComboBox" Width="280" HorizontalAlignment="Left" Margin="0,8,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Hat" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="HatComboBox" Width="280" HorizontalAlignment="Left" Margin="0,8,0,0" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Accessory" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="AccessoryComboBox" Width="280" HorizontalAlignment="Left" Margin="0,8,0,0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Skin color" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border Width="22" Height="22" CornerRadius="6" BorderBrush="#22000000" BorderThickness="1"
                                                Background="{Binding Text, ElementName=SkinColorTextBox, Converter={StaticResource HexBrush}}" />
                                        <TextBox x:Name="SkinColorTextBox" Width="240" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Shirt color" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="22" Height="22" CornerRadius="6" BorderBrush="#22000000" BorderThickness="1"
                                                Background="{Binding Text, ElementName=ShirtColorTextBox, Converter={StaticResource HexBrush}}" />
                                        <TextBox x:Name="ShirtColorTextBox" Width="240" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Pants color" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="22" Height="22" CornerRadius="6" BorderBrush="#22000000" BorderThickness="1"
                                                Background="{Binding Text, ElementName=PantsColorTextBox, Converter={StaticResource HexBrush}}" />
                                        <TextBox x:Name="PantsColorTextBox" Width="240" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Hat color" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="22" Height="22" CornerRadius="6" BorderBrush="#22000000" BorderThickness="1"
                                                Background="{Binding Text, ElementName=HatColorTextBox, Converter={StaticResource HexBrush}}" />
                                        <TextBox x:Name="HatColorTextBox" Width="240" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Accent color" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="22" Height="22" CornerRadius="6" BorderBrush="#22000000" BorderThickness="1"
                                                Background="{Binding Text, ElementName=AccentColorTextBox, Converter={StaticResource HexBrush}}" />
                                        <TextBox x:Name="AccentColorTextBox" Width="240" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Palette" VerticalAlignment="Top" Margin="0,12,0,0" />
                                    <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,12,0,0">
                                        <ComboBox x:Name="PaletteTargetComboBox" Width="220" HorizontalAlignment="Left" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#F2C9A0" BorderBrush="#22000000" BorderThickness="1" Tag="#F2C9A0" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#DFA37F" BorderBrush="#22000000" BorderThickness="1" Tag="#DFA37F" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#B96E4D" BorderBrush="#22000000" BorderThickness="1" Tag="#B96E4D" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#000000" BorderBrush="#22000000" BorderThickness="1" Tag="#000000" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#FFFFFF" BorderBrush="#22000000" BorderThickness="1" Tag="#FFFFFF" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#EF4444" BorderBrush="#22000000" BorderThickness="1" Tag="#EF4444" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#F59E0B" BorderBrush="#22000000" BorderThickness="1" Tag="#F59E0B" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#22C55E" BorderBrush="#22000000" BorderThickness="1" Tag="#22C55E" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#3B82F6" BorderBrush="#22000000" BorderThickness="1" Tag="#3B82F6" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#A855F7" BorderBrush="#22000000" BorderThickness="1" Tag="#A855F7" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#6B7280" BorderBrush="#22000000" BorderThickness="1" Tag="#6B7280" Click="PaletteColorButton_Click" />
                                            <Button Width="26" Height="26" Margin="0,0,8,8" Background="#111827" BorderBrush="#22000000" BorderThickness="1" Tag="#111827" Click="PaletteColorButton_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Packs">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Packs" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Grid.Row="1" Foreground="#FF6B7280" Margin="0,8,0,16"
                                   Text="Export creates a .zip with settings.json. Import applies the settings to the buddy." />

                        <WrapPanel Grid.Row="2">
                            <Button x:Name="ExportPackButton" Content="Export Pack" Width="160" Margin="0,0,12,12" Click="ExportPackButton_Click" />
                            <Button x:Name="ImportPackButton" Content="Import Pack" Width="160" Margin="0,0,12,12" Click="ImportPackButton_Click" />
                        </WrapPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,16">
            <Button x:Name="ApplyButton" Content="Apply (Live)" Width="140" Margin="0,0,10,0" Click="ApplyButton_Click" />
            <Button x:Name="SaveButton" Content="Save + Apply" Width="140" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
