<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Computer Buddy"
           Manufacturer="Computer Buddy"
           Version="1.0.12"
           UpgradeCode="3D5D2511-3F7E-42D8-9D07-1A9B3C9B091D"
           InstallerVersion="500"
           Compressed="yes"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="MainFeature" Title="Computer Buddy" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <Property Id="STARTWITHWINDOWS" Value="1" />
    <Property Id="ARPURLUPDATEINFO" Value="https://drive.google.com/uc?export=download&amp;id=1wzVV_AypEbPCvKU63p39wYU_sP2UBd3d" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andreasloutsios/Computer-Buddy" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Control Center" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <CustomAction Id="LaunchControlCenter"
                  FileRef="ComputerBuddyManagerExe"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <WixVariable Id="WixUILicenseRtf" Value="installer\ComputerBuddy.License.rtf" />

    <ui:WixUI Id="WixUI_Minimal" />

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchControlCenter"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Computer Buddy" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Computer Buddy" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="cmp_MainExe" Guid="*">
        <File Id="ComputerBuddyExe" Source="publish\ComputerBuddy.App\win-x64-selfcontained-compressed\ComputerBuddy.App.exe" KeyPath="yes" />
        <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
      </Component>

      <Component Id="cmp_ManagerExe" Guid="*">
        <File Id="ComputerBuddyManagerExe" Source="publish\ComputerBuddy.Manager\win-x64-selfcontained-compressed\ComputerBuddy.Manager.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuDir" Name="Computer Buddy" WorkingDirectory="INSTALLFOLDER" />
        </File>
      </Component>

      <Component Id="cmp_RunAtStartup" Guid="*" Condition="STARTWITHWINDOWS = 1">
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="ComputerBuddy"
                       Value="&quot;[INSTALLFOLDER]ComputerBuddy.App.exe&quot;"
                       Type="string"
                       KeyPath="yes" />
      </Component>

      <Component Id="cmp_D3DCompiler" Guid="*">
        <File Source="publish\ComputerBuddy.App\win-x64-selfcontained-compressed\D3DCompiler_47_cor3.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmp_PenImc" Guid="*">
        <File Source="publish\ComputerBuddy.App\win-x64-selfcontained-compressed\PenImc_cor3.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmp_PresentationNative" Guid="*">
        <File Source="publish\ComputerBuddy.App\win-x64-selfcontained-compressed\PresentationNative_cor3.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmp_VCRuntime" Guid="*">
        <File Source="publish\ComputerBuddy.App\win-x64-selfcontained-compressed\vcruntime140_cor3.dll" KeyPath="yes" />
      </Component>

      <Component Id="cmp_Wpfgfx" Guid="*">
        <File Source="publish\ComputerBuddy.App\win-x64-selfcontained-compressed\wpfgfx_cor3.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
